# ============================================================================
# Nachhaltigkeitsdashboard — Konfiguration
#
# Kopieren als .env, Werte eintragen. Die Datei enthält Geheimnisse und ist
# per .gitignore ausgeschlossen. Auf dem Server: chmod 600 .env
#
# docker-compose reicht diese Datei per `env_file: .env` an das Backend durch.
# ============================================================================

# ---- Datenbank -------------------------------------------------------------
# WICHTIG: Muss auf /data zeigen. Das ist der Mountpoint des docker-Volumes
# `db_data`. Ein relativer Pfad landet in der Schreibschicht des Containers und
# ist bei jedem `docker compose up --build` verloren — samt aller Accounts.
#   Entwicklung: file:./local.db
#   Produktion:  file:/data/local.db
DB_FILE_NAME=file:/data/local.db

# ---- Öffentliche Adresse ---------------------------------------------------
# Die wichtigste Zeile der Datei. Daran hängen zwei Schutzmechanismen:
#   1. Beginnt der Wert mit https://, werden Session-Cookies als `Secure`
#      ausgeliefert. Bei http:// nicht — die Session wäre abgreifbar.
#   2. Fehlt SMTP_HOST, bricht der Mailversand hart ab, statt Reset-Tokens
#      ins Log zu schreiben.
# Muss die von außen erreichbare Domain sein, nicht localhost.
BETTER_AUTH_URL=https://dashboard.hs-mainz.de

# Ziel der Einladungs- und Passwort-Reset-Links in den E-Mails.
# Hinter nginx identisch mit BETTER_AUTH_URL.
APP_URL=https://dashboard.hs-mainz.de

# Erlaubte Herkünfte. Dient gleichzeitig als trustedOrigins für Better Auth:
# Anmeldeversuche von anderen Origins werden abgewiesen (CSRF-Schutz).
# Kommagetrennt, ohne Leerzeichen.
CORS_ORIGINS=https://dashboard.hs-mainz.de

# ---- Auth ------------------------------------------------------------------
# Signiert die Session-Cookies. Für Produktion NEU erzeugen, nicht den
# Entwicklungswert übernehmen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Ein Wechsel dieses Werts macht alle bestehenden Sessions ungültig.
BETTER_AUTH_SECRET=

# ---- E-Mail ----------------------------------------------------------------
# Ohne SMTP_HOST können keine Einladungen und keine Passwort-Resets zugestellt
# werden. In Produktion führt ein leerer Wert bewusst zu einem Fehler.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hs-mainz.de

# ---- Siemens BuildingX (Raumsensorik) --------------------------------------
BUILDINGX_CLIENT_ID=
BUILDINGX_CLIENT_SECRET=
BUILDINGX_PARTITION=
