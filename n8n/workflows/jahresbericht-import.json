      {
        "parameters": {
          "jsCode": "const results = [];\nconst geschlechterMap = { weiblich: 'weiblich', maennlich: 'männlich', divers: 'divers' };\nconst departmentMap = {\n  'Wirtschaft': 'Fachbereich Wirtschaft',\n  'Technik': 'Technik',\n  'Gestaltung': 'Gestaltung',\n  'Zentrale Verwaltung': 'Zentrale Verwaltung & Services'\n};\n\nfor (const item of $input.all()) {\n  const year = item.json[\"Daten.year\"];\n  const employeeInfo = item.json[\"Daten.employee_demographics\"];\n  const department = departmentMap[employeeInfo.department] || employeeInfo.department;\n\n  for (const g of Object.keys(geschlechterMap)) {\n    results.push({\n      json: {\n        year: year,\n        department: department,\n        gender: geschlechterMap[g],\n        count: employeeInfo[g] || 0\n      }\n    });\n  }\n}\n\nreturn results;"
        },
