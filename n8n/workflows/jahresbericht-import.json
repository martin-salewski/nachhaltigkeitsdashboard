        "parameters": {
          "jsCode": "const items = $(\"Code in JavaScript1\").all(); \nconst existing_data = $(\"HTTP Check2\").all();\n\nreturn items.map(item => {\n  const existing = existing_data.find(i => \n    String(i.json.year) == String(item.json.year) && \n    i.json.department == item.json.department && \n    i.json.gender == item.json.gender\n  );\n  \n  item.json.httpMethod = existing ? 'PUT' : 'POST';\nconst hasId = existing && existing.json && existing.json.id;\n\n  item.json.httpMethod = hasId ? 'PUT' : 'POST';\n  \n  item.json.apiUrl = hasId \n    ? 'http://host.docker.internal:3000/api/staff_demographics/' + existing.json.id \n    : 'http://host.docker.internal:3000/api/staff_demographics';\n\n  item.json.debug_found = hasId ? existing.json.id : 'NICHT GEFUNDEN';\n  \n  return item;\n});"
